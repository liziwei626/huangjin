# 复制为 .env 并填写，或在 GitHub Actions Secrets 中配置同名变量。
# 注意：多个值用英文逗号分隔。

# PushPlus（免费，一个 token 对应一个微信用户；多个 token = 推送给多人）
PUSHPLUS_TOKENS=

# Server酱（免费额度，一个 SendKey 对应一个微信用户）
SERVERCHAN_KEYS=

# WxPusher（免费，推送给多个关注者）
WXPUSHER_APP_TOKEN=
WXPUSHER_UIDS=
WXPUSHER_TOPIC_IDS=

# 企业微信群机器人 Webhook（群内多人可见，可填多个群）
WECOM_WEBHOOKS=
